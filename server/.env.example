# Copy this file to .env and fill in real values. Never commit .env.

# Neon → Connect → turn "Connection pooling" OFF → copy the connection string.
# (Our Express server is long-running and keeps its own pool, so a direct connection is right.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Needed from Phase 2b. platform.openai.com → API keys.
OPENAI_API_KEY="sk-..."
